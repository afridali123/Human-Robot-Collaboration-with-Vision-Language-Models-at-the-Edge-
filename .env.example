# Copy this file to .env on the Jetson and edit values as needed.

# Camera settings
CAMERA_INDEX=0
USB_CAMERA_DEVICE=/dev/video0
CSI_SENSOR_ID=0
CAPTURE_IMAGE=images/capture.jpg
SAMPLE_IMAGE=images/sample.jpg
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15

# Hugging Face image VLM demo
HF_VLM_MODEL=llava-hf/llava-1.5-7b-hf
VLM_PROMPT=Describe this scene for a robot assistant.
MAX_NEW_TOKENS=120

# Jetson Platform Services VLM demo
JETSON_IP=127.0.0.1
JPS_API=http://127.0.0.1:5010
JPS_HEALTH_URL=http://127.0.0.1:5015/v1/health
JPS_STREAM_ID=

# Local RTSP stream
RTSP_SERVER_URL=rtsp://127.0.0.1:8554/camera
RTSP_PUBLIC_URL=rtsp://127.0.0.1:8554/camera

# Setup behavior
JETSON_SET_MAX_PERF=true
JETSON_CONTAINERS_DIR=$HOME/jetson-containers
JETSON_CONTAINER_PACKAGE=llava
